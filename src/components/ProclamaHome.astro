---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
import logoSrc from "../images/logo.png";
import darkSrc from "../images/proclama_dark.webp";
import lightSrc from "../images/proclama_light.webp";
import easyToUseSrc from "../images/easy-to-use.jpg";
import compatibilitySrc from "../images/compatibility.jpg";

export interface Props { lang: "es" | "en" | "pt"; }
const { lang } = Astro.props;
const copy = {
  es: { title:"Proclama | Presentador multimedia para iglesias", description:"Un presentador multimedia ligero para proyectar canciones, versículos, anuncios y videos en iglesias pequeñas.", nav:["Funciones","Control remoto","Requisitos","Licencia"], download:"Descargar", badge:"Versión 1.8.1 · multiplataforma", heroTitle:"Proyecta el mensaje con claridad.", heroLead:"Proclama ayuda a iglesias pequeñas a preparar y presentar canciones, Escrituras, anuncios, imágenes y videos desde una sola consola, sin exigir equipos costosos ni una curva de aprendizaje complicada.", primary:"Descargar Proclama", secondary:"Conocer las funciones", stats:[["14 días","de prueba"],["Windows · Linux · macOS","multiplataforma"],["C++ / Qt","ligero y fluido"]], introTitle:"Una herramienta hecha para servir", intro:"Quien opera la proyección debería concentrarse en el culto, no en pelearse con el software. Proclama reúne lo esencial en una interfaz directa, rápida y pensada para voluntarios.", featureTitle:"Todo lo necesario para una presentación ordenada", features:[["playlist_play","Playlist visual","Ordena canciones, versículos, imágenes, presentaciones y videos. Reacomoda los elementos con arrastrar y soltar y reproduce cada entrada en el orden del servicio."],["search","Búsqueda rápida","Encuentra versículos y compara traducciones al instante. Proyecta el resultado sin abandonar la presentación ni interrumpir el flujo del culto."],["desktop_windows","Dos pantallas","Opera desde la consola mientras la audiencia ve una salida limpia. La vista previa, el estado y la reproducción permanecen sincronizados."],["music_note","Biblioteca local","Conserva canciones, Biblias y medios en una biblioteca local que funciona incluso cuando no hay conexión a Internet."],["picture_as_pdf","Medios y presentaciones","Importa videos, imágenes, PDFs y archivos PPTX para convertirlos en elementos listos para la playlist."],["tune","Control de la proyección","Fondo negro, logo, marquesina, repetición, volumen, pantalla de escenario y ajustes visuales al alcance del operador."],["settings_input_antenna","NDI para producción","Envía la proyección a la red local para usarla en OBS Studio o vMix, sin una capturadora dedicada. Disponible en PRO."],["phone_iphone","Control remoto web","Controla la playlist y las acciones rápidas desde un teléfono o tablet conectados a la misma red local."],["speed","Pensado para equipos modestos","La reproducción local, la búsqueda optimizada y la aceleración disponible ayudan a aprovechar computadoras que ya están en la iglesia."]], remoteTitle:"El operador no tiene que estar frente al proyector", remote:"Activa el servidor web integrado y controla la presentación desde cualquier teléfono o tablet en la red local. La consola muestra qué está en pantalla y permite avanzar, limpiar, activar logo o poner la salida en negro.", remotePoints:["Sin cuentas ni servicios externos","Estado de conexión visible","Acceso por IP local o código QR","Cambios sincronizados en tiempo real"], requirementsTitle:"Requisitos claros", requirements:["Windows 10 x64, incluido 1809, o posterior","Linux con las dependencias de Qt y multimedia de la distribución","macOS según el instalador publicado","NDI es opcional; la proyección local no depende de él","Se recomienda una GPU compatible con la aceleración disponible, pero no se requiere equipo de última generación"], licenseTitle:"Empieza sin presión", licenseLead:"Prueba Proclama durante 14 días. Si encaja con la forma de servir de tu iglesia, adquiere una licencia permanente por congregación.", trial:"Prueba gratuita", trialItems:["14 días con funciones completas","Sin tarjeta para comenzar","Incluye playlist, búsqueda y control remoto"], license:"Licencia por congregación", licenseItems:["Pago único de $19.99 USD","Uso permanente para la iglesia","Incluye NDI, PRO y actualizaciones menores"], buy:"Comprar licencia", downloadTitle:"Descarga la versión 1.8.1", downloadLead:"Elige tu sistema operativo y consulta los instaladores publicados en GitHub.", releases:"Ver descargas en GitHub", footerVerse:"Proclamad entre las naciones su gloria, en todos los pueblos sus maravillas.", footerRef:"Salmos 96:3 · RVR1960" },
  en: { title:"Proclama | Multimedia presentation for churches", description:"A lightweight multimedia presenter for small churches to project songs, Scripture, announcements and video.", nav:["Features","Remote control","Requirements","License"], download:"Download", badge:"Version 1.8.1 · cross-platform", heroTitle:"Present the message with clarity.", heroLead:"Proclama helps small churches prepare and present songs, Scripture, announcements, images and video from one console, without expensive hardware or a complicated learning curve.", primary:"Download Proclama", secondary:"Explore features", stats:[["14 days","free trial"],["Windows · Linux · macOS","cross-platform"],["C++ / Qt","lightweight and smooth"]], introTitle:"A tool made to serve", intro:"The person running the presentation should focus on worship, not wrestle with software. Proclama keeps the essentials in a direct, fast interface designed for volunteers.", featureTitle:"Everything needed for an orderly presentation", features:[["playlist_play","Visual playlist","Arrange songs, Scripture, images, presentations and video. Reorder entries with drag and drop and play them in service order."],["search","Quick search","Find Scripture and compare translations instantly. Project the result without leaving the presentation or interrupting the service."],["desktop_windows","Two screens","Operate from the console while the audience sees a clean output. Preview, status and playback stay synchronized."],["music_note","Local library","Keep songs, Bibles and media in a local library that works even when there is no Internet connection."],["picture_as_pdf","Media and presentations","Import video, images, PDFs and PPTX files and turn them into playlist-ready items."],["tune","Projection controls","Black screen, logo, ticker, repeat, volume, stage display and visual settings are available to the operator."],["settings_input_antenna","NDI for production","Send the projection across the local network to OBS Studio or vMix without a dedicated capture card. Available in PRO."],["phone_iphone","Web remote","Control the playlist and quick actions from a phone or tablet connected to the same local network."],["speed","Built for modest computers","Local playback, optimized search and available acceleration help make the most of computers already serving the church."]], remoteTitle:"The operator does not have to stand by the projector", remote:"Enable the integrated web server and control the presentation from any phone or tablet on the local network. The console shows what is on screen and lets you advance, clear, show the logo or black out the output.", remotePoints:["No accounts or external services","Visible connection status","Access by local IP or QR code","Real-time synchronized changes"], requirementsTitle:"Clear requirements", requirements:["Windows 10 x64, including 1809, or later","Linux with the distribution's Qt and multimedia dependencies","macOS according to the published installer","NDI is optional; local projection does not depend on it","A GPU compatible with available acceleration is recommended, but cutting-edge hardware is not required"], licenseTitle:"Start without pressure", licenseLead:"Try Proclama for 14 days. If it fits the way your church serves, purchase a permanent congregation license.", trial:"Free trial", trialItems:["14 days with full features","No card required to start","Includes playlist, search and web remote"], license:"Congregation license", licenseItems:["One-time payment of $19.99 USD","Permanent use for your church","Includes PRO, NDI and minor updates"], buy:"Buy license", downloadTitle:"Download version 1.8.1", downloadLead:"Choose your operating system and find the published installers on GitHub.", releases:"View downloads on GitHub", footerVerse:"Declare his glory among the nations, his marvelous works among all the peoples.", footerRef:"Psalm 96:3 · KJV" },
  pt: { title:"Proclama | Apresentador multimídia para igrejas", description:"Um apresentador multimídia leve para igrejas pequenas projetarem músicas, Escrituras, avisos e vídeos.", nav:["Recursos","Controle remoto","Requisitos","Licença"], download:"Baixar", badge:"Versão 1.8.1 · multiplataforma", heroTitle:"Apresente a mensagem com clareza.", heroLead:"O Proclama ajuda igrejas pequenas a preparar e apresentar músicas, Escrituras, avisos, imagens e vídeos em um único console, sem exigir equipamentos caros ou uma curva de aprendizado complicada.", primary:"Baixar o Proclama", secondary:"Conhecer os recursos", stats:[["14 dias","de teste"],["Windows · Linux · macOS","multiplataforma"],["C++ / Qt","leve e fluido"]], introTitle:"Uma ferramenta feita para servir", intro:"Quem opera a projeção deve se concentrar no culto, não lutar contra o software. O Proclama reúne o essencial em uma interface direta, rápida e pensada para voluntários.", featureTitle:"Tudo o que é necessário para uma apresentação organizada", features:[["playlist_play","Playlist visual","Organize músicas, Escrituras, imagens, apresentações e vídeos. Reordene os itens com arrastar e soltar e reproduza tudo na ordem do culto."],["search","Busca rápida","Encontre Escrituras e compare traduções instantaneamente. Projete o resultado sem sair da apresentação nem interromper o culto."],["desktop_windows","Duas telas","Opere pelo console enquanto o público vê uma saída limpa. A prévia, o estado e a reprodução permanecem sincronizados."],["music_note","Biblioteca local","Mantenha músicas, Bíblias e mídias em uma biblioteca local que funciona mesmo sem Internet."],["picture_as_pdf","Mídias e apresentações","Importe vídeos, imagens, PDFs e arquivos PPTX e transforme-os em itens prontos para a playlist."],["tune","Controle da projeção","Tela preta, logo, letreiro, repetição, volume, tela de palco e ajustes visuais ao alcance do operador."],["settings_input_antenna","NDI para produção","Envie a projeção pela rede local para OBS Studio ou vMix sem uma placa de captura dedicada. Disponível no PRO."],["phone_iphone","Controle remoto web","Controle a playlist e as ações rápidas de um celular ou tablet conectado à mesma rede local."],["speed","Feito para computadores modestos","A reprodução local, a busca otimizada e a aceleração disponível ajudam a aproveitar computadores que a igreja já possui."]], remoteTitle:"O operador não precisa estar diante do projetor", remote:"Ative o servidor web integrado e controle a apresentação de qualquer celular ou tablet na rede local. O console mostra o que está na tela e permite avançar, limpar, exibir o logo ou escurecer a saída.", remotePoints:["Sem contas ou serviços externos","Estado da conexão visível","Acesso por IP local ou QR code","Alterações sincronizadas em tempo real"], requirementsTitle:"Requisitos claros", requirements:["Windows 10 x64, incluindo 1809, ou posterior","Linux com as dependências de Qt e multimídia da distribuição","macOS conforme o instalador publicado","NDI é opcional; a projeção local não depende dele","Recomenda-se uma GPU compatível com a aceleração disponível, mas não é necessário hardware de última geração"], licenseTitle:"Comece sem pressão", licenseLead:"Teste o Proclama por 14 dias. Se ele se encaixar na forma como sua igreja serve, adquira uma licença permanente por congregação.", trial:"Teste gratuito", trialItems:["14 dias com todos os recursos","Sem cartão para começar","Inclui playlist, busca e controle remoto web"], license:"Licença por congregação", licenseItems:["Pagamento único de US$ 19,99","Uso permanente para sua igreja","Inclui PRO, NDI e atualizações menores"], buy:"Comprar licença", downloadTitle:"Baixe a versão 1.8.1", downloadLead:"Escolha seu sistema operacional e consulte os instaladores publicados no GitHub.", releases:"Ver downloads no GitHub", footerVerse:"Anunciai entre as nações a sua glória, entre todos os povos as suas maravilhas.", footerRef:"Salmos 96:3 · O Livro" }
}[lang];
const base = import.meta.env.BASE_URL;
copy.badge = copy.badge.replace("1.8.1", "1.8.2");
copy.downloadTitle = copy.downloadTitle.replace("1.8.1", "1.8.2");
copy.requirements = lang === "es"
  ? [
      "Windows 10 x64, versión 1809 o posterior; también Windows 11 x64",
      "Linux x86_64: Ubuntu/Debian (.deb), Fedora/Red Hat (.rpm) y Arch Linux (.pkg.tar.zst)",
      "macOS 13 Ventura o posterior; instalador universal para Intel (x86_64) y Apple Silicon (arm64)",
      "Qt 6 y los componentes multimedia requeridos por la distribución; los paquetes oficiales incluyen sus dependencias principales",
    ]
  : lang === "en"
    ? [
        "Windows 10 x64, version 1809 or later; Windows 11 x64 is also supported",
        "Linux x86_64: Ubuntu/Debian (.deb), Fedora/Red Hat (.rpm) and Arch Linux (.pkg.tar.zst)",
        "macOS 13 Ventura or later; universal installer for Intel (x86_64) and Apple Silicon (arm64)",
        "Qt 6 and the multimedia components required by the distribution; official packages include their main dependencies",
      ]
    : [
        "Windows 10 x64, versão 1809 ou posterior; o Windows 11 x64 também é compatível",
        "Linux x86_64: Ubuntu/Debian (.deb), Fedora/Red Hat (.rpm) e Arch Linux (.pkg.tar.zst)",
        "macOS 13 Ventura ou posterior; instalador universal para Intel (x86_64) e Apple Silicon (arm64)",
        "Qt 6 e os componentes multimídia exigidos pela distribuição; os pacotes oficiais incluem suas principais dependências",
      ];
const routes = { es: base, en: `${base.replace(/\/?$/, "/")}en/`, pt: `${base.replace(/\/?$/, "/")}pt/` };
const ui = lang === "es"
  ? { preview: "Vista previa de Proclama", dark: "Oscuro", light: "Claro", oneTime: "pago único", trialDays: "/ 14 días", worship: "Amazing Grace", john: "Juan 3:16", romans: "Romanos 8:28", video: "Vídeo", clear: "Limpiar", black: "Negro", contact: "Contacto", ndiNotice: "Proclama utiliza la tecnología NDI® SDK — © NewTek, Inc. y/o sus afiliadas. Todos los derechos reservados.", ndiLicense: "Acuerdo de licencia del software NDI", screenText: "“Porque de tal manera amó Dios al mundo…”", screenRef: "Juan 3:16", darkAlt: "Interfaz oscura de Proclama", lightAlt: "Interfaz clara de Proclama" }
  : lang === "en"
    ? { preview: "Proclama preview", dark: "Dark", light: "Light", oneTime: "one-time payment", trialDays: "/ 14 days", worship: "Amazing Grace", john: "John 3:16", romans: "Romans 8:28", video: "Video", clear: "Clear", black: "Black", contact: "Contact", ndiNotice: "Proclama uses NDI® SDK technology — © NewTek, Inc. and/or its affiliates. All rights reserved.", ndiLicense: "NDI Software License Agreement", screenText: "“For God so loved the world…”", screenRef: "John 3:16", darkAlt: "Proclama dark interface", lightAlt: "Proclama light interface" }
    : { preview: "Prévia do Proclama", dark: "Escuro", light: "Claro", oneTime: "pagamento único", trialDays: "/ 14 dias", worship: "Maravilhosa Graça", john: "João 3:16", romans: "Romanos 8:28", video: "Vídeo", clear: "Limpar", black: "Preto", contact: "Contato", ndiNotice: "O Proclama utiliza a tecnologia NDI® SDK — © NewTek, Inc. e/ou suas afiliadas. Todos os direitos reservados.", ndiLicense: "Contrato de licença do software NDI", screenText: "“Porque Deus amou o mundo de tal maneira…”", screenRef: "João 3:16", darkAlt: "Interface escura do Proclama", lightAlt: "Interface clara do Proclama" };
copy.trialItems = lang === "es"
  ? [
      "14 días con todas las funciones PRO",
      "Después: edición gratuita indefinida con funciones limitadas",
    ]
  : lang === "en"
    ? [
        "14 days with all PRO features",
        "Afterward: indefinite free edition with limited features",
      ]
    : [
        "14 dias com todos os recursos PRO",
        "Depois: edição gratuita por tempo indeterminado com recursos limitados",
      ];
copy.trialLimits = lang === "es"
  ? ["Marca de agua en la proyección", "Hasta 3 versiones de la Biblia", "10 cambios diarios en el remoto web", "NDI, Stage Display, Chroma Key y respaldos automáticos requieren PRO"]
  : lang === "en"
    ? ["Watermark on the projection", "Up to 3 Bible versions", "10 daily web remote changes", "NDI, Stage Display, Chroma Key and automated backups require PRO"]
    : ["Marca d'água na projeção", "Até 3 versões da Bíblia", "10 alterações diárias no controle remoto web", "NDI, Stage Display, Chroma Key e backups automáticos exigem o PRO"];
copy.licenseItems = [
  ...copy.licenseItems.slice(0, 2),
  lang === "es"
    ? "Actualizaciones incluidas hasta dos versiones mayores: una licencia adquirida para 1.x.x cubre hasta la última versión menor de 3.x.x, pero no la serie 4.x.x"
    : lang === "en"
      ? "Updates included through two major versions: a license purchased for 1.x.x covers releases through the latest 3.x.x minor version, but not the 4.x.x series"
      : "Atualizações incluídas até duas versões principais: uma licença adquirida para 1.x.x cobre até a última versão menor de 3.x.x, mas não a série 4.x.x",
];
---
<Layout lang={lang} title={copy.title} description={copy.description}>
  <header><div class="container nav-wrapper"><a href={routes[lang]} class="logo"><Image src={logoSrc} alt="Proclama" loading="eager" /><span>Proclama</span></a><button class="menu-toggle" id="menuToggle" aria-label="Menu"><span></span><span></span><span></span></button><nav class="nav-links" id="navLinks">{copy.nav.map((item, i) => <a href={["#features","#remote","#requirements","#pricing"][i]}>{item}</a>)}<a href="#download" class="nav-btn">{copy.download}</a><div class="language-links"><a href={routes.es}>ES</a><a href={routes.en}>EN</a><a href={routes.pt}>PT</a></div></nav></div></header>
  <main data-lang={lang}>
    <section class="hero"><div class="container hero-grid"><div class="hero-content"><div class="badge"><span></span>{copy.badge}</div><h1>{copy.heroTitle}</h1><p>{copy.heroLead}</p><div class="cta-group"><a href="#download" class="btn btn-primary">{copy.primary}<span class="material-symbols-rounded">arrow_forward</span></a><a href="#features" class="btn btn-secondary">{copy.secondary}</a></div><div class="features-quick">{copy.stats.map(([num,label]) => <div class="quick-stat"><span class="num">{num}</span><span class="label">{label}</span></div>)}</div></div><div class="hero-visual"><div class="theme-switcher-container"><div class="theme-tabs"><span class="preview-label">{ui.preview}</span><button class="tab-btn active" id="tabDarkBtn">{ui.dark}</button><button class="tab-btn" id="tabLightBtn">{ui.light}</button></div><div class="mockup-wrapper"><Image id="mockupDark" src={darkSrc} alt={ui.darkAlt} loading="eager" /><Image id="mockupLight" src={lightSrc} alt={ui.lightAlt} style="display:none" loading="eager" /></div></div><div class="hero-offer"><div><strong>{copy.license}</strong><span>$19.99 USD · {ui.oneTime}</span></div><a href="#pricing">{copy.buy}<span class="material-symbols-rounded">arrow_forward</span></a></div></div></div></section>
    <section class="intro-section"><div class="container intro-grid"><div class="section-kicker">01 / {copy.introTitle}</div><div class="intro-content"><p>{copy.intro}</p><figure class="intro-image"><Image src={easyToUseSrc} alt={lang === "es" ? "Persona usando una computadora para preparar una presentación" : lang === "en" ? "Person using a computer to prepare a presentation" : "Pessoa usando um computador para preparar uma apresentação"} loading="lazy" /><figcaption>{lang === "es" ? "Preparar la presentación debe ser tan sencillo como abrir la computadora y comenzar." : lang === "en" ? "Preparing a presentation should be as simple as opening the computer and getting started." : "Preparar a apresentação deve ser tão simples quanto abrir o computador e começar."}</figcaption></figure></div></div></section>
    <section id="features" class="features-section"><div class="container"><div class="section-header"><div class="eyebrow">02 / {copy.featureTitle}</div><h2>{copy.featureTitle}</h2></div><div class="features-grid">{copy.features.map(([icon,title,text]) => <article class="feature-card"><div class="card-icon"><span class="material-symbols-rounded">{icon}</span></div><h3>{title}</h3><p>{text}</p></article>)}</div></div></section>
    <section id="remote" class="demo-section"><div class="container demo-grid"><div class="demo-left"><div class="eyebrow">03 / remote</div><h2>{copy.remoteTitle}</h2><p>{copy.remote}</p><ul class="demo-features-list">{copy.remotePoints.map(point => <li><span class="material-symbols-rounded">check</span>{point}</li>)}</ul></div><div class="demo-showcase"><div class="mock-phone"><div class="phone-speaker"></div><div class="phone-screen"><div class="phone-header">Proclama Remote</div><div class="phone-playlist"><div class="phone-item" data-slide-id="tu-fidelidad">🎵 {ui.worship}</div><div class="phone-item selected" data-slide-id="juan-3-16">📖 {ui.john}</div><div class="phone-item" data-slide-id="romans-8-28">📖 {ui.romans}</div><div class="phone-item" data-slide-id="cuan-grande-el">🎬 {ui.video}</div></div><div class="phone-controls"><button class="phone-btn" id="btnClear"><span class="material-symbols-rounded">clear_all</span>{ui.clear}</button><button class="phone-btn" id="btnLogo"><span class="material-symbols-rounded">wallpaper</span>Logo</button><button class="phone-btn phone-btn-danger" id="btnBlack"><span class="material-symbols-rounded">dark_mode</span>{ui.black}</button></div></div></div><div class="mock-projector-screen" id="mockScreen"><div class="screen-bg-image" id="screenBg"></div><div class="screen-dim"></div><div class="screen-logo"><Image src={logoSrc} alt="Proclama" /><span>Proclama</span></div><div class="screen-content" id="screenContent"><div class="screen-text" id="screenText">{ui.screenText}</div><div class="screen-ref" id="screenRef">{ui.screenRef}</div></div></div></div></div></section>
    <section id="requirements" class="requirements-section"><div class="container"><div class="section-header"><div class="eyebrow">04 / {lang === "es" ? "compatibilidad" : lang === "en" ? "compatibility" : "compatibilidade"}</div><h2>{copy.requirementsTitle}</h2></div><div class="compatibility-grid"><figure class="compatibility-image"><Image src={compatibilitySrc} alt={lang === "es" ? "Windows, Linux y macOS" : lang === "en" ? "Windows, Linux and macOS" : "Windows, Linux e macOS"} loading="lazy" /></figure><div class="requirements-card"><h3>{lang === "es" ? "Sistemas operativos compatibles" : lang === "en" ? "Supported operating systems" : "Sistemas operacionais compatíveis"}</h3><ul class="req-list">{copy.requirements.map(item => <li>{item}</li>)}</ul><div class="hardware-grid"><div><strong>{lang === "es" ? "Hardware mínimo" : lang === "en" ? "Minimum hardware" : "Hardware mínimo"}</strong><ul><li>{lang === "es" ? "CPU x64 de 2 núcleos" : lang === "en" ? "2-core x64 CPU" : "CPU x64 de 2 núcleos"}</li><li>{lang === "es" ? "4 GB de RAM" : lang === "en" ? "4 GB RAM" : "4 GB de RAM"}</li><li>{lang === "es" ? "GPU compatible con OpenGL 3.3" : lang === "en" ? "GPU compatible with OpenGL 3.3" : "GPU compatível com OpenGL 3.3"}</li><li>1280×720</li></ul></div><div><strong>{lang === "es" ? "Hardware recomendado" : lang === "en" ? "Recommended hardware" : "Hardware recomendado"}</strong><ul><li>{lang === "es" ? "CPU x64 de 4 núcleos" : lang === "en" ? "4-core x64 CPU" : "CPU x64 de 4 núcleos"}</li><li>{lang === "es" ? "8 GB de RAM y SSD" : lang === "en" ? "8 GB RAM and SSD" : "8 GB de RAM e SSD"}</li><li>{lang === "es" ? "GPU con aceleración por hardware" : lang === "en" ? "Hardware-accelerated GPU" : "GPU com aceleração de hardware"}</li><li>1920×1080</li></ul></div></div></div></div></div></section>
    <section id="pricing" class="pricing-section"><div class="container"><div class="section-header"><div class="eyebrow">05 / license</div><h2>{copy.licenseTitle}</h2><p>{copy.licenseLead}</p></div><div class="pricing-card-wrapper"><article class="pricing-card"><div><div class="plan-label">proclama free</div><h3>{copy.trial}</h3><div class="price">$0<span>{ui.trialDays}</span></div><ul class="pricing-features">{copy.trialItems.map(item => <li><span class="material-symbols-rounded">check</span>{item}</li>)}<li class="pricing-details"><span class="material-symbols-rounded">check</span><span>{lang === "es" ? "Restricciones posteriores" : lang === "en" ? "Post-trial limits" : "Limitações após o teste"}<ul>{copy.trialLimits.map(item => <li>{item}</li>)}</ul></span></li></ul></div><a href="#download" class="btn btn-secondary">{copy.download}</a></article><article class="pricing-card premium"><div><div class="plan-label">proclama pro</div><h3>{copy.license}</h3><div class="price">$19.99<span> USD · {ui.oneTime}</span></div><ul class="pricing-features">{copy.licenseItems.map(item => <li><span class="material-symbols-rounded">check</span>{item}</li>)}</ul></div><a href="https://buy.stripe.com/bJe3cv3lwc6g9sn4Y6e7m00" target="_blank" rel="noreferrer" class="btn btn-primary">{copy.buy}<span class="material-symbols-rounded">arrow_outward</span></a></article></div></div></section>
