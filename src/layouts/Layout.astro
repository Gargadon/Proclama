---
import { Image } from 'astro:assets';
import logoSrc from '../images/logo.png';

export interface Props {
  lang?: string;
}
const { lang = 'es' } = Astro.props;
---
<!DOCTYPE html>
<html lang={lang}>
<head>
    <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Proclama - Presentador Multimedia para Iglesias Modernas</title>
  <meta name="description" content="Proclama es un presentador multimedia multiplataforma diseñado específicamente para iglesias y congregaciones. Incluye doble pantalla, importación de PDFs, buscador rápido y control remoto web.">
  <link rel="icon" type="image/png" href={logoSrc.src}>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />
    <slot name="head" />
</head>
<body>
    <slot />
    <script>
      import '../scripts/index.js';
    </script>
</body>
</html>
